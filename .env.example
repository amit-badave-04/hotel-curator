# Hotel Curator configuration
# Copy to .env and fill in values

# Model checkpoint directory
CURATOR_MODEL_DIR=artifacts/hotel_curator_clf

# Threshold set: "val" (default) or "gold" (gold-set re-tuned)
CURATOR_THRESHOLD_SET=val

# Inference settings
CURATOR_MAX_SEQ_LENGTH=256
CURATOR_INFERENCE_BATCH_SIZE=64
CURATOR_USE_BF16=false

# API settings
CURATOR_API_HOST=0.0.0.0
CURATOR_API_PORT=8000

# Database (SQLite for dev; PostgreSQL for prod)
CURATOR_DATABASE_URL=sqlite+aiosqlite:///./hotel_curator.db

# Bootstrap
CURATOR_BOOTSTRAP_N=1000
CURATOR_BOOTSTRAP_SEED=42

# LLM API key (for NB02b/NB02c training pipeline only)
# XAI_API_KEY=your-key-here
