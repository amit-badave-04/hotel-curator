# hotel-curator settings. Copy to .env and edit; every variable is optional.
# All names map 1:1 to fields of hotel_curator.config.Settings.
# Never put secrets in this file or commit a .env file (it is gitignored).

# Root directory for data/ and artifacts/ (default: current directory)
# CURATOR_HOME=/path/to/hotel-curator

# DEBUG | INFO | WARNING | ERROR
CURATOR_LOG_LEVEL=INFO
# console (readable) | json (one JSON object per line)
CURATOR_LOG_FORMAT=console

# SQLite for local use. docker compose sets
# postgresql+psycopg://curator@/curator?host=/var/run/postgresql (Postgres on
# a Unix socket, no network and no password). For your own database use e.g.
# postgresql+psycopg://<user>:<password>@<host>:5432/<db>, only in .env.
CURATOR_DATABASE_URL=sqlite:///./var/hotel_curator.db

# Model package directory (model.onnx, tokenizer.json, metadata.json); by
# default the winner named in artifacts/evals/promotion.json
# CURATOR_MODEL_PACKAGE=artifacts/models/<name>
# Tier policy (default: config/tier_policy.yaml)
# CURATOR_TIER_POLICY=config/tier_policy.yaml

# API protection
CURATOR_CORS_ORIGINS=["http://localhost:5173","http://localhost:8080"]
CURATOR_RATE_LIMIT_PER_MINUTE=120
CURATOR_ANALYZE_RATE_LIMIT_PER_MINUTE=30
CURATOR_MAX_REQUEST_BYTES=64000
CURATOR_MAX_PART_CHARS=2000
CURATOR_MAX_PAGE_SIZE=100

# Seed for splits, sampling and bootstraps
CURATOR_SEED=20261024

# Proxy whose X-Forwarded-For is trusted (docker compose sets the web container)
# CURATOR_FORWARDED_ALLOW_IPS=172.28.0.10
