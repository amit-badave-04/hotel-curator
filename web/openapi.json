 "info": {
  "description": "\nHotel quality tiers built from guest reviews, with the evidence behind them.\n\n* Tiers and grades follow a pre-registered policy (`/v1/meta` shows every\n  value); every number can be recomputed from the `positive`, `negative`\n  and `reviews` fields.\n* Rate limits are per client and per process; exceeding them returns 429\n  with `Retry-After`.\n* Errors share one shape: `{\"error\": {\"code\", \"message\", \"request_id\"}}`.\n",
  "title": "hotel-curator API",
  "version": "2.0.0"
 },
 "openapi": "3.1.0",
 "paths": {
  "/healthz": {
   "get": {
    "description": "The process is up.",
    "operationId": "healthz_healthz_get",
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Health"
        }
       }
      },
      "description": "Successful Response"
     },
     "422": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/ErrorResponse"
        }
       }
      },
      "description": "Unprocessable Entity"
     },
     "429": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/ErrorResponse"
        }
       }
      },
      "description": "Too Many Requests"
     }
    },
    "summary": "Liveness probe",
    "tags": [
     "health"
    ]
   }
  },
  "/readyz": {
   "get": {
    "description": "Ready when the database answers and hotel data is loaded.\n\nThe model is reported but not required: search and details work without\nit; only ``/v1/analyze`` needs it.",
    "operationId": "readyz_readyz_get",
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Health"
        }
       }
      },
      "description": "Successful Response"
     },
     "422": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/ErrorResponse"
        }
       }
      },
      "description": "Unprocessable Entity"
     },
     "429": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/ErrorResponse"
        }
       }
      },
      "description": "Too Many Requests"
     }
    },
    "summary": "Readiness probe",
    "tags": [
     "health"
    ]
   }
  },
  "/v1/analyze": {
   "post": {
    "description": "Run the classifier on a Liked and/or Disliked text.\n\nNothing is stored and the text is not returned. Each part is capped at\n``CURATOR_MAX_PART_CHARS`` characters.",
    "operationId": "analyze_v1_analyze_post",
    "requestBody": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/AnalyzeRequest"
       }
      }
     },
     "required": true
    },
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/AnalyzeResponse"
        }
       }
      },
      "description": "Successful Response"
     },
     "422": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/ErrorResponse"
        }
       }
      },
      "description": "Unprocessable Entity"
     },
     "429": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/ErrorResponse"
        }
       }
      },
      "description": "Too Many Requests"
     },
     "503": {
      "description": "Model not loaded"
     }
    },
    "summary": "Label a review with the served model",
    "tags": [
     "analyze"
    ]
   }
  },
  "/v1/cities": {
   "get": {
    "description": "Cities in the data, with hotel counts.",
    "operationId": "cities_v1_cities_get",
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {
         "items": {
          "$ref": "#/components/schemas/City"
         },
         "title": "Response Cities V1 Cities Get",
         "type": "array"
        }
       }
      },
      "description": "Successful Response"
     },
     "422": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/ErrorResponse"
        }
       }
      },
      "description": "Unprocessable Entity"
     },
     "429": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/ErrorResponse"
        }
       }
      },
      "description": "Too Many Requests"
     }
    },
    "summary": "Cities with hotels",
    "tags": [
     "hotels"
    ]
   }
  },
  "/v1/compare": {
   "get": {
    "description": "Compare 2-4 hotels; differences are flagged only when credible.",
    "operationId": "compare_v1_compare_get",
    "parameters": [
     {
      "in": "query",
      "name": "ids",
      "required": true,
      "schema": {
       "items": {
        "pattern": "^h_[0-9a-f]{10}$",
        "type": "string"
       },
       "maxItems": 4,
       "minItems": 2,
       "title": "Ids",
       "type": "array"
      }
     }
    ],
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Comparison"
        }
       }
      },
      "description": "Successful Response"
     },
     "422": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/ErrorResponse"
        }
       }
      },
      "description": "Unprocessable Entity"
     },
     "429": {
      "content": {
