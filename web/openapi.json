     },
     "highlights": {
      "items": {
       "$ref": "#/components/schemas/Attribute"
      },
      "title": "Highlights",
      "type": "array"
     },
     "hotel_id": {
      "title": "Hotel Id",
      "type": "string"
     },
     "if_ignored": {
