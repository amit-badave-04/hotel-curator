     },
     "lng": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "null"
       }
      ],
      "title": "Lng"
     },
     "name": {
      "title": "Name",
      "type": "string"
     },
     "provenance": {
      "$ref": "#/components/schemas/ProvenanceOut"
     },
     "review_volume": {
      "description": "Usable reviews per month from first_month to last_month, months without reviews included as 0.",
