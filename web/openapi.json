{
 "components": {
  "schemas": {
   "AnalyzeRequest": {
    "description": "A review split the way the booking site splits it.",
    "properties": {
     "disliked": {
      "default": "",
      "maxLength": 20000,
      "title": "Disliked",
      "type": "string"
     },
     "liked": {
      "default": "",
      "maxLength": 20000,
      "title": "Liked",
      "type": "string"
     }
    },
    "title": "AnalyzeRequest",
    "type": "object"
   },
   "AnalyzeResponse": {
    "description": "Model output for the submitted review.",
    "properties": {
     "model": {
      "title": "Model",
      "type": "string"
     },
     "parts": {
      "items": {
       "$ref": "#/components/schemas/PartOut"
      },
      "title": "Parts",
      "type": "array"
     }
    },
    "required": [
     "model",
     "parts"
    ],
    "title": "AnalyzeResponse",
    "type": "object"
   },
   "Attribute": {
    "description": "A hotel quality attribute that guests judge in reviews.",
    "enum": [
     "cleanliness",
     "room",
     "staff",
     "location",
     "noise",
     "wifi",
     "value",
     "food"
    ],
    "title": "Attribute",
    "type": "string"
   },
   "AttributeInfo": {
    "description": "One of the eight hotel attributes.",
    "properties": {
     "attribute": {
      "$ref": "#/components/schemas/Attribute"
     },
     "description": {
      "title": "Description",
      "type": "string"
     },
     "display_name": {
      "title": "Display Name",
      "type": "string"
     },
     "essential": {
      "title": "Essential",
      "type": "boolean"
     },
     "family": {
      "title": "Family",
      "type": "string"
     }
    },
    "required": [
     "attribute",
     "display_name",
     "description",
     "essential",
     "family"
    ],
    "title": "AttributeInfo",
    "type": "object"
   },
   "AttributeOut": {
    "additionalProperties": false,
    "description": "One attribute's grade and every number behind it.",
    "properties": {
     "attribute": {
      "$ref": "#/components/schemas/Attribute"
     },
     "complaining_reviews": {
      "title": "Complaining Reviews",
      "type": "integer"
     },
     "complaint_rate": {
      "title": "Complaint Rate",
      "type": "number"
     },
     "display_name": {
      "title": "Display Name",
      "type": "string"
     },
     "essential": {
      "title": "Essential",
      "type": "boolean"
     },
     "family": {
      "description": "two_sided: share of opinions that are praise; must_be: complaint rate among all reviews (noise, wifi).",
      "enum": [
       "two_sided",
       "must_be"
      ],
      "title": "Family",
      "type": "string"
     },
     "grade": {
      "$ref": "#/components/schemas/Grade"
     },
     "high": {
      "description": "Upper end of the 90% likely range.",
      "title": "High",
      "type": "number"
     },
     "lean": {
      "anyOf": [
       {
        "$ref": "#/components/schemas/Lean"
       },
       {
        "type": "null"
       }
      ]
     },
     "low": {
      "description": "Lower end of the 90% likely range.",
      "title": "Low",
      "type": "number"
     },
     "material": {
      "title": "Material",
      "type": "boolean"
     },
     "mean": {
      "description": "Posterior mean of the same measure.",
      "title": "Mean",
      "type": "number"
     },
     "negative": {
      "description": "N: expected number of reviews complaining about it.",
      "title": "Negative",
      "type": "number"
     },
     "negative_hard": {
      "description": "Reviews with a part labelled as a complaint at probability >= 0.5.",
      "title": "Negative Hard",
      "type": "integer"
     },
     "observed": {
      "description": "Raw share of praise (two_sided) or complaint rate (must_be).",
      "title": "Observed",
      "type": "number"
     },
     "opinions": {
      "description": "M = P + N.",
      "title": "Opinions",
      "type": "number"
     },
     "positive": {
      "description": "P: expected number of reviews praising the attribute.",
      "title": "Positive",
      "type": "number"
     },
     "positive_hard": {
      "description": "Reviews with a part labelled as praise at probability >= 0.5 (used to confirm a Weak essential before Caution).",
      "title": "Positive Hard",
      "type": "integer"
     },
     "prob_strong": {
      "title": "Prob Strong",
      "type": "number"
     },
     "prob_weak": {
      "title": "Prob Weak",
      "type": "number"
     },
     "quotes": {
      "items": {
       "$ref": "#/components/schemas/QuoteOut"
      },
      "title": "Quotes",
      "type": "array"
     },
     "reviews": {
      "description": "n: eligible reviews of the hotel.",
      "title": "Reviews",
      "type": "integer"
     },
     "trend": {
      "anyOf": [
       {
        "$ref": "#/components/schemas/TrendOut"
       },
       {
        "type": "null"
       }
      ]
     }
    },
    "required": [
     "attribute",
     "display_name",
     "essential",
     "family",
     "grade",
     "lean",
     "observed",
     "mean",
     "low",
     "high",
     "prob_strong",
     "prob_weak",
     "positive",
     "negative",
     "opinions",
     "reviews",
     "complaint_rate",
     "material",
     "complaining_reviews",
     "positive_hard",
     "negative_hard"
    ],
    "title": "AttributeOut",
    "type": "object"
   },
   "BlockerKind": {
    "description": "Why a hotel is not in the next tier up.",
    "enum": [
     "more_reviews",
     "more_opinions",
     "confirm_strong",
     "share_too_low",
     "weak_essential",
     "material_weak",
     "review_spread"
    ],
    "title": "BlockerKind",
    "type": "string"
   },
   "BlockerOut": {
    "additionalProperties": false,
    "description": "One condition between the hotel and the next tier up.",
    "properties": {
     "attribute": {
      "anyOf": [
       {
        "$ref": "#/components/schemas/Attribute"
       },
       {
        "type": "null"
       }
      ]
     },
     "kind": {
      "$ref": "#/components/schemas/BlockerKind"
     },
     "more": {
      "anyOf": [
       {
        "type": "integer"
       },
       {
        "type": "null"
       }
      ],
      "title": "More"
     },
     "text": {
      "title": "Text",
      "type": "string"
     }
    },
    "required": [
     "kind",
     "attribute",
     "more",
     "text"
    ],
    "title": "BlockerOut",
    "type": "object"
   },
   "City": {
    "description": "A city with hotels.",
    "properties": {
     "city": {
      "title": "City",
      "type": "string"
     },
     "country": {
      "title": "Country",
      "type": "string"
     },
     "hotels": {
      "title": "Hotels",
      "type": "integer"
     }
    },
    "required": [
     "city",
     "country",
     "hotels"
    ],
    "title": "City",
    "type": "object"
   },
   "ComparePolicy": {
    "additionalProperties": false,
    "description": "Credible-difference rule for hotel comparisons.",
    "properties": {
     "draws": {
      "minimum": 100.0,
      "title": "Draws",
      "type": "integer"
     },
     "probability": {
      "exclusiveMaximum": 1.0,
      "exclusiveMinimum": 0.5,
      "title": "Probability",
      "type": "number"
     }
    },
    "required": [
     "probability",
     "draws"
    ],
    "title": "ComparePolicy",
    "type": "object"
   },
   "CompareRow": {
    "description": "One attribute across the compared hotels.",
    "properties": {
     "attribute": {
      "$ref": "#/components/schemas/Attribute"
     },
     "leader": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "description": "Hotel credibly better than every other one on this attribute (posterior probability >= 0.95), if any.",
      "title": "Leader"
     },
     "leader_probability": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "null"
       }
      ],
      "title": "Leader Probability"
     },
     "values": {
      "items": {
       "$ref": "#/components/schemas/CompareValue"
      },
      "title": "Values",
      "type": "array"
     }
    },
    "required": [
     "attribute",
     "values",
     "leader",
     "leader_probability"
    ],
    "title": "CompareRow",
    "type": "object"
   },
   "CompareValue": {
    "description": "One hotel's numbers on one attribute.",
    "properties": {
     "grade": {
      "$ref": "#/components/schemas/Grade"
     },
     "high": {
      "title": "High",
      "type": "number"
     },
     "hotel_id": {
      "title": "Hotel Id",
      "type": "string"
     },
     "low": {
      "title": "Low",
      "type": "number"
     },
     "observed": {
      "title": "Observed",
      "type": "number"
     },
     "opinions": {
      "title": "Opinions",
      "type": "number"
     }
    },
    "required": [
     "hotel_id",
     "grade",
     "observed",
     "low",
     "high",
     "opinions"
    ],
    "title": "CompareValue",
    "type": "object"
   },
   "Comparison": {
    "description": "Side-by-side comparison of 2-4 hotels.",
    "properties": {
     "attributes": {
      "items": {
       "$ref": "#/components/schemas/CompareRow"
      },
      "title": "Attributes",
      "type": "array"
     },
     "hotels": {
      "items": {
       "$ref": "#/components/schemas/HotelSummary"
      },
      "title": "Hotels",
      "type": "array"
     }
    },
    "required": [
     "hotels",
     "attributes"
    ],
    "title": "Comparison",
    "type": "object"
   },
   "DataPeriod": {
    "description": "First and last month of the usable reviews behind the tiers.",
    "properties": {
     "first_month": {
      "examples": [
       "2015-08"
      ],
      "pattern": "^\\d{4}-\\d{2}$",
      "title": "First Month",
      "type": "string"
     },
     "last_month": {
      "examples": [
       "2017-08"
      ],
      "pattern": "^\\d{4}-\\d{2}$",
      "title": "Last Month",
      "type": "string"
     }
    },
    "required": [
     "first_month",
     "last_month"
    ],
    "title": "DataPeriod",
    "type": "object"
   },
   "ErrorBody": {
    "description": "Machine-readable code, human message, request id for support.",
    "properties": {
     "code": {
      "title": "Code",
      "type": "string"
     },
     "fields": {
      "anyOf": [
       {
        "items": {
         "$ref": "#/components/schemas/FieldError"
        },
        "type": "array"
       },
       {
        "type": "null"
       }
      ],
      "title": "Fields"
     },
     "message": {
      "title": "Message",
      "type": "string"
     },
     "request_id": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Request Id"
     }
    },
    "required": [
     "code",
     "message"
    ],
    "title": "ErrorBody",
    "type": "object"
   },
   "ErrorResponse": {
    "description": "Body of every 4xx/5xx response.",
    "properties": {
     "error": {
      "$ref": "#/components/schemas/ErrorBody"
     }
    },
    "required": [
     "error"
    ],
    "title": "ErrorResponse",
    "type": "object"
   },
   "Evaluation": {
    "description": "Headline gold-test numbers of the served model versus v1.\n\nFor a judged ONNX package, macro_f1, difference and mean_review_ece\nare the package's own numbers; v1_macro_f1 is always v1's.",
    "properties": {
     "difference": {
      "$ref": "#/components/schemas/Interval"
     },
     "macro_f1": {
      "$ref": "#/components/schemas/Interval"
     },
     "mean_review_ece": {
      "title": "Mean Review Ece",
      "type": "number"
     },
     "model": {
      "title": "Model",
      "type": "string"
     },
     "rungs": {
      "items": {
       "additionalProperties": true,
       "type": "object"
      },
      "title": "Rungs",
      "type": "array"
     },
     "test_hotels": {
      "anyOf": [
       {
        "type": "integer"
       },
       {
        "type": "null"
       }
      ],
      "description": "Hotels those test reviews come from.",
      "title": "Test Hotels"
     },
     "test_reviews": {
      "anyOf": [
       {
        "type": "integer"
       },
       {
        "type": "null"
       }
      ],
      "description": "Held-out test reviews behind the scores.",
      "title": "Test Reviews"
     },
     "v1_configuration": {
      "title": "V1 Configuration",
      "type": "string"
     },
     "v1_macro_f1": {
      "$ref": "#/components/schemas/Interval"
     }
    },
    "required": [
     "model",
     "v1_configuration",
     "macro_f1",
     "v1_macro_f1",
     "difference",
     "mean_review_ece",
     "rungs"
    ],
    "title": "Evaluation",
    "type": "object"
   },
   "ExcellentGate": {
    "additionalProperties": false,
    "description": "Review-spread conditions for the top tier.",
    "properties": {
     "max_month_share": {
      "exclusiveMinimum": 0.0,
      "maximum": 1.0,
      "title": "Max Month Share",
      "type": "number"
     },
     "min_months": {
      "minimum": 1.0,
      "title": "Min Months",
      "type": "integer"
     }
    },
    "required": [
     "min_months",
     "max_month_share"
    ],
    "title": "ExcellentGate",
    "type": "object"
   },
   "ExplanationOut": {
    "additionalProperties": false,
    "description": "Plain-language explanation generated from the fields above.",
    "properties": {
     "essentials": {
      "items": {
       "type": "string"
      },
      "title": "Essentials",
      "type": "array"
     },
     "for_you": {
      "items": {
       "type": "string"
      },
      "title": "For You",
      "type": "array"
     },
     "label": {
      "title": "Label",
      "type": "string"
     },
     "verdict": {
      "title": "Verdict",
      "type": "string"
     },
     "what_would_change": {
      "items": {
       "type": "string"
      },
      "title": "What Would Change",
      "type": "array"
     },
     "who_it_suits": {
      "items": {
       "type": "string"
      },
      "title": "Who It Suits",
      "type": "array"
     }
    },
    "required": [
     "label",
     "verdict",
     "essentials",
     "what_would_change",
     "for_you"
    ],
    "title": "ExplanationOut",
    "type": "object"
   },
   "FieldError": {
    "description": "One invalid input field.",
    "properties": {
     "location": {
      "items": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "integer"
        }
       ]
      },
      "title": "Location",
      "type": "array"
     },
     "message": {
      "title": "Message",
      "type": "string"
     }
    },
    "required": [
     "location",
     "message"
    ],
    "title": "FieldError",
    "type": "object"
   },
   "Grade": {
    "description": "Attribute grade; the API enum.",
    "enum": [
     "strong",
     "weak",
     "ok",
     "too_few"
    ],
    "title": "Grade",
    "type": "string"
   },
   "Health": {
    "description": "Probe result.",
    "properties": {
     "hotels": {
      "anyOf": [
       {
        "type": "integer"
       },
       {
        "type": "null"
       }
      ],
      "title": "Hotels"
     },
     "model": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Model"
     },
     "status": {
      "title": "Status",
      "type": "string"
     }
    },
    "required": [
     "status"
    ],
    "title": "Health",
    "type": "object"
   },
   "HotelDetail": {
