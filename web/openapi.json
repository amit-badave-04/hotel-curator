      },
      "title": "Review Volume",
      "type": "array"
     },
     "reviews_eligible": {
      "title": "Reviews Eligible",
      "type": "integer"
     },
     "reviews_total": {
      "title": "Reviews Total",
      "type": "integer"
     },
     "segments": {
      "items": {
       "$ref": "#/components/schemas/SegmentOut"
      },
      "title": "Segments",
      "type": "array"
     },
