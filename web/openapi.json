     "address": {
      "title": "Address",
      "type": "string"
     },
     "attributes": {
      "items": {
       "$ref": "#/components/schemas/AttributeOut"
      },
      "title": "Attributes",
      "type": "array"
     },
     "blockers": {
      "items": {
       "$ref": "#/components/schemas/BlockerOut"
      },
      "title": "Blockers",
      "type": "array"
     },
     "catches": {
      "items": {
       "$ref": "#/components/schemas/Attribute"
      },
      "title": "Catches",
      "type": "array"
     },
     "city": {
      "title": "City",
      "type": "string"
     },
     "country": {
      "title": "Country",
      "type": "string"
     },
     "essentials": {
      "additionalProperties": {
       "$ref": "#/components/schemas/Grade"
      },
      "propertyNames": {
       "$ref": "#/components/schemas/Attribute"
      },
