     "city",
     "country",
     "address",
     "lat",
     "lng",
     "tier",
     "label",
     "sort_score",
     "reviews_eligible",
     "reviews_total",
     "catches",
     "highlights",
     "essentials",
     "attributes",
     "explanation",
     "blockers",
     "if_ignored",
     "first_month",
