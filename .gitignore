# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.eggs/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/

# Credentials (never commit; see .env.example)
.env
.env.*
# Local compose overrides (may hold a database URL with a password)
docker-compose.override.yml
!.env.example

# Data that is rebuilt by `make data` (manifests in data/manifests are committed)
data/raw/
data/processed/
# Evaluation-only external data with unverified licences (never committed)
data/external/
*.part

# Runtime state
var/
*.db
*.db-journal
mlruns/
mlflow.db

# Model training scratch (the promoted package lives in artifacts/models/<rung>/)
checkpoints/
artifacts/models/*/checkpoint/
# Served model weights go through Git LFS (.gitattributes): the promoted
# model's model.onnx is tracked; add a newly published one with `git add -f`.
artifacts/models/*/model.onnx

# Frontend
node_modules/
web/dist/
web/playwright-report/
web/test-results/
web/coverage/

# IDE / OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
.ipynb_checkpoints/

# Panel prompts are rebuilt from the committed samples (`curator label prompts`)
data/labels/*/prompts/
